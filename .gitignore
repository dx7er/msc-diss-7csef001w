# VM images and hypervisor state
*.vmdk
*.vmx
*.vmxf
*.vmsd
*.vmss
*.vmem
*.nvram
*.log
*.scoreboard
DISS-Win11-Testbed-VM/
*-flat.vmdk

# Raw acquisition outputs. Layouts:
#   Single run scenarios : scenarios/scenario_N/artefacts/{class}/
#   Multi run scenarios  : scenarios/scenario_N/run_M/artefacts/{class}/
# Evidence blobs are too large and PII adjacent for git; only the SHA 256
# manifest per run is committed for chain of custody documentation.
scenarios/scenario_*/artefacts/**
scenarios/scenario_*/run_*/artefacts/**
!scenarios/scenario_*/artefacts/supporting/acquisition_manifest.csv
!scenarios/scenario_*/run_*/artefacts/supporting/acquisition_manifest.csv

# Office lock files and temporary drafts
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Node
node_modules/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
*.key
*.pem
credentials.json

# Large forensic binaries anywhere (belt and braces alongside scenarios/*/*/artefacts/**)
*.evtx
*.pf

# Housekeeping folders local to scripts (never committed)
scripts/**/_to_delete/
_to_delete/
